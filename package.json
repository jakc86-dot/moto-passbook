{
  "name": "moto-passbook",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "go:android": "expo start --android",
    "go:ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir work/expo-android-export --clear",
    "export:ios": "expo export --platform ios --output-dir work/expo-ios-export --clear",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:android:apk": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:android:store": "npx --yes eas-cli@latest build --platform android --profile production",
    "build:ios:simulator": "npx --yes eas-cli@latest build --platform ios --profile preview",
    "build:ios:store": "npx --yes eas-cli@latest build --platform ios --profile production",
    "submit:android:latest": "npx --yes eas-cli@latest submit --platform android --profile production --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "expo-doctor": "^1.19.10",
    "typescript": "~5.9.2"
  }
}
